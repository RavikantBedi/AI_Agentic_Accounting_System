# ============================================================================
# AI Ledger — environment configuration
#
# Every value here is OPTIONAL. The application runs with none of them set:
# SQLite locally, an ephemeral signing key, and the deterministic AI provider.
# Copy this file to backend/.env and set only what you need.
# ============================================================================

# ---- Application -----------------------------------------------------------
APP_NAME=AI Ledger
ENVIRONMENT=local              # local | development | staging | production
DEBUG=true
API_PREFIX=/api/v1

# ---- Database --------------------------------------------------------------
# Leave DATABASE_URL unset to use the built-in default: <repo>/data/ailedger.db,
# resolved from the application's own location so it works from any directory.
#
# If you do set it, note that a relative sqlite path resolves against the
# working directory — "sqlite:///./data/ailedger.db" means <repo>/data when you
# start from the repository root and <repo>/backend/data when you start from
# backend/. Use an absolute path to avoid the ambiguity.
#
# DATABASE_URL=sqlite:////absolute/path/to/data/ailedger.db
# DATABASE_URL=postgresql+psycopg://ailedger:password@localhost:5432/ailedger
SQL_ECHO=false

# ---- Security --------------------------------------------------------------
# Generated per-process if unset, which signs everyone out on restart.
# REQUIRED in production: the app refuses to start without it.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

ACCESS_TOKEN_TTL_MINUTES=720
REFRESH_TOKEN_TTL_MINUTES=20160
PASSWORD_HASH_ITERATIONS=240000

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
RATE_LIMIT_PER_MINUTE=300
AUTH_RATE_LIMIT_PER_MINUTE=10
MAX_UPLOAD_BYTES=26214400      # 25 MB

# ---- Storage ---------------------------------------------------------------
STORAGE_DIR=./data/storage

# ---- AI providers ----------------------------------------------------------
# Priority when set to auto:  Gemini -> Grok -> Ollama -> Mock
# Mock is deterministic, always available, and needs no key. Leave everything
# below empty and the product still works end to end.
LLM_PROVIDER=auto              # auto | gemini | grok | ollama | mock
LLM_TIMEOUT_SECONDS=45
LLM_MAX_RETRIES=2

# Google Gemini — https://aistudio.google.com/apikey  (keys begin 'AIza' or 'AQ.')
# Model names retire; if the AI falls back to the deterministic provider,
# check Settings > AI providers — it reports the exact reason.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# xAI Grok — https://console.x.ai  (keys begin 'xai-')
# Note: a 'gsk_' key is a Groq key. Groq and xAI's Grok are different
# services and the keys are not interchangeable.
GROK_API_KEY=
GROK_MODEL=grok-2-latest

# Ollama — local, free, no key.  ollama pull llama3.1
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# ---- Regulatory providers --------------------------------------------------
# Mock mode generates clearly-labelled DEMO identifiers with no legal validity.
# The live client refuses to run without full credentials rather than faking a
# response — a fabricated IRN would be far worse than an error.
GST_PROVIDER=mock              # mock | government
EINVOICE_PROVIDER=mock         # mock | irp
EWAYBILL_PROVIDER=mock         # mock | nic

EINVOICE_API_BASE=
EINVOICE_USERNAME=
EINVOICE_PASSWORD=
EINVOICE_CLIENT_ID=
EINVOICE_CLIENT_SECRET=

# ---- Banking ---------------------------------------------------------------
# Statements are imported from files. No live bank connection is implemented.
BANK_PROVIDER=file             # file | mock

# ---- Localisation ----------------------------------------------------------
DEFAULT_CURRENCY=INR
DEFAULT_COUNTRY=IN
DEFAULT_TIMEZONE=Asia/Kolkata
